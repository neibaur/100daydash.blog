{
  "name": "@100daydash/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^6.3.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^10.4.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md}": "prettier --write"
  }
}
