---
const { frontmatter, nextEntry, previousEntry } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={frontmatter.description} />
    <title>{frontmatter.title} | 100daydash.blog</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="post-shell">
      <a class="site-link" href="/">100daydash.blog</a>
      <article class="post">
        <header class="post-header">
          <p>Day {frontmatter.day}</p>
          <h1>{frontmatter.title}</h1>
          <p>{frontmatter.description}</p>
        </header>
        <slot />
        {
          (previousEntry || nextEntry) && (
            <nav class="entry-nav" aria-label="Journal entry navigation">
              {previousEntry ? (
                <a class="entry-nav-link" href={previousEntry.href} rel="prev">
                  <span>Previous Entry</span>
                  <strong>
                    {previousEntry.title || `Day ${previousEntry.day}`}
                  </strong>
                </a>
              ) : (
                <span class="entry-nav-spacer" aria-hidden="true" />
              )}
              {nextEntry ? (
                <a
                  class="entry-nav-link entry-nav-link-next"
                  href={nextEntry.href}
                  rel="next"
                >
                  <span>Next Entry</span>
                  <strong>{nextEntry.title || `Day ${nextEntry.day}`}</strong>
                </a>
              ) : (
                <span class="entry-nav-spacer" aria-hidden="true" />
              )}
            </nav>
          )
        }
      </article>
    </main>
  </body>
</html>
