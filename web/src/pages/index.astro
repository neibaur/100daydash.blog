---
import { getCollection } from "astro:content";
import "../styles/global.css";

const posts = await getCollection("blog");
const sortedPosts = posts.sort((a, b) => b.data.day - a.data.day);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Isaac Neibaur's 100-day dashboard project for building rapid-response data skills with Python, Astro, and Cloudflare."
    />
    <title>100daydash.blog</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="home-shell">
      <section class="home-hero">
        <p>100 dashboards in 100 days</p>
        <h1>100daydash.blog</h1>
        <p>
          Isaac Neibaur's public sprint to turn disciplined data engineering
          practice into useful dashboards, shipped one day at a time.
        </p>
      </section>

      <section class="post-list" aria-labelledby="about-project">
        <h2 id="about-project">About The Project</h2>
        <article>
          <p>Who</p>
          <h3>Isaac Neibaur</h3>
          <p>Data Engineer & Platform Architect.</p>
        </article>
        <article>
          <p>Goal</p>
          <h3>Build 100 dashboards in 100 days</h3>
          <p>
            The aim is to develop consistency and rapid-response data skills by
            repeatedly moving from question to dataset, analysis, visualization,
            and published dashboard.
          </p>
        </article>
        <article>
          <p>Tech</p>
          <h3>Python + Astro + Cloudflare monorepo</h3>
          <p>
            The project emphasizes engineering rigor: meaningful test coverage
            at or above 80%, CI validation, metadata standards, and a
            local-first workflow that keeps each dashboard reviewable.
          </p>
        </article>
      </section>

      <section class="post-list" aria-labelledby="latest-posts">
        <h2 id="latest-posts">Latest Posts</h2>
        {
          sortedPosts.map((post) => (
            <article>
              <p>Day {post.data.day}</p>
              <h3>
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>
