{
  "name": "100daydash-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm --dir web build",
    "dev": "pnpm --dir web dev",
    "lint": "pnpm --dir web lint",
    "format": "pnpm --dir web format",
    "format:check": "pnpm --dir web format:check",
    "typecheck": "pnpm --dir web typecheck",
    "test": "pnpm --dir web test",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "yaml": "2.9.0",
      "postcss": ">=8.5.10",
      "esbuild": ">=0.28.1",
      "astro>js-yaml": "4.3.0",
      "@astrojs/internal-helpers>js-yaml": "4.3.0"
    }
  }
}
