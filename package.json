{
  "name": "100daydash-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --dir web build",
    "dev": "pnpm --dir web dev",
    "lint": "pnpm --dir web lint",
    "format": "pnpm --dir web format",
    "format:check": "pnpm --dir web format:check",
    "typecheck": "pnpm --dir web typecheck",
    "test": "pnpm --dir web test",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.12",
      "fast-uri": "3.1.8",
      "yaml": "2.9.0",
      "nanoid": "3.3.19",
      "postcss": ">=8.5.23",
      "esbuild": ">=0.28.1",
      "astro>js-yaml": "4.3.2",
      "@astrojs/internal-helpers>js-yaml": "4.3.2",
      "sharp@^0.35": "0.35.4",
      "smol-toml@^1": "1.8.0",
      "svgo@^4": "4.1.0",
      "devalue@^5": "5.9.4",
      "undici@^8": "8.10.2"
    }
  }
}
